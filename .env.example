# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sanity CMS (see the "Content Management (Sanity Studio)" section in README.md).
# These are not secret - they're needed in the browser bundle to query Sanity's CDN -
# but can still be overridden per-environment via these vars if needed.
VITE_SANITY_PROJECT_ID="xmtc060o"
VITE_SANITY_DATASET="production"

# Google Analytics 4 measurement ID. Not secret - it's public in every page's
# source - but overridable per-environment (e.g. a separate GA property for staging).
VITE_GA_MEASUREMENT_ID="G-0VMQX8NMJZ"

# Resend (see the "Email Notifications (Resend)" section in README.md).
# This is a real secret - keep it out of version control. Used by server.ts
# (Express, via dotenv) to email info.safartrails@gmail.com when a "Get Your
# Custom Trip Quote" enquiry is submitted. If unset, quote emails are simply
# skipped - the enquiry and WhatsApp flow are unaffected either way.
# (If deploying on Cloudflare Pages instead, set these in the Pages project's
# environment variables / .dev.vars instead - see .dev.vars.example.)
RESEND_API_KEY="re_your_api_key_here"
# Optional - defaults to Resend's shared sandbox sender until you verify your own domain.
# RESEND_FROM_EMAIL="SafarTrails Enquiries <enquiries@yourdomain.com>"
