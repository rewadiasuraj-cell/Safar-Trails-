# Cloudflare Pages redirect + rewrite rules.
#
# Ordering note: Cloudflare Pages serves a matching static asset before applying
# a non-forced rule, so the prerendered files written by scripts/prerender.ts
# (e.g. /destinations/kashmir/index.html) win over the SPA rewrites below.

# --- Canonical host ---------------------------------------------------------
# NOTE: these two lines are almost certainly INERT, and are kept only as a
# belt-and-braces fallback.
#
# The www host was returning HTTP 522, which means Cloudflare's edge could not
# reach an origin at all - the request fails BEFORE the Pages project (and
# therefore this file) is ever consulted. On top of that, Pages only matches
# relative paths in the source column; a hostname source like the ones below is
# Netlify syntax and is ignored here.
#
# The authoritative fix is a Cloudflare Redirect Rule at the zone level, which
# runs at the edge and does not need a working origin. See
# docs/seo-implementation.md, "Canonical host".
https://www.safartrails.co.in/* https://safartrails.co.in/:splat 301!
http://www.safartrails.co.in/* https://safartrails.co.in/:splat 301!

# --- Duplicate / legacy paths ----------------------------------------------
# /about and /about-us were both live and returning 200 = duplicate content.
# One canonical URL each, everything else 301s into it.
/about           /about-us     301
/about-us/       /about-us     301
/contact         /contact-us   301
/contact-us/     /contact-us   301
/faq             /about-us     301
/reviews         /about-us     301
/blog            /guides       301
/blog/*          /guides       301
/thank-you       /             301

# --- Retired package URLs ---------------------------------------------------
# Packages used to be served from two places - a CMS at /packages/<slug> and the
# local data file at /tour-packages/<slug>, same slug, same trip. Content now
# lives in one place, so there is one URL: /tour-packages/<slug>, which is what
# the canonical tags and the submitted sitemap already point at.
#
# These 301s exist because /packages/<slug> URLs were in the sitemap Google read
# before the migration and may hold history. First match wins, so the one slug
# that does not map across by name is listed before the catch-all.
/packages/chardham-yatra-package  /tour-packages/chardham-yatra-haridwar-yamunotri-gangotri-kedarnath-badrinath-10d9n  301
/packages/*                       /tour-packages/:splat                                                                301

# --- SPA fallback for client-routed detail pages ----------------------------
# Scoped deliberately to these prefixes. A blanket "/* /index.html 200" would
# answer 200 for every junk URL (a soft 404), which is what the audit warned
# about; without it, unmatched paths fall through to 404.html and Cloudflare
# Pages returns a real HTTP 404.
#
# /packages/* is absent on purpose - it is a 301 above, and /packages itself is a
# prerendered file that the rules never reach.
/destinations/*  /index.html   200
/tour-packages/* /index.html   200
/guides/*        /index.html   200
